{
    "name": "ak279642/laravel-infrastructure",
    "description": "Reusable Laravel infrastructure for repositories, safe tagged caching, repository-aware FormRequests, slug and file lifecycle handling, validation contexts, API responses, logging, and transaction boundaries.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "repository",
        "cache",
        "caching",
        "infrastructure",
        "repository-pattern",
        "query-filter",
        "validation",
        "transactions",
        "form-request",
        "slug",
        "file-storage"
    ],
    "authors": [
        {
            "name": "Avinash Kumar",
            "email": "ak279642@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ak279642\\LaravelInfrastructure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ak279642\\LaravelInfrastructure\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ak279642\\LaravelInfrastructure\\LaravelInfrastructureServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:architecture": "phpunit --testsuite=Architecture"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
