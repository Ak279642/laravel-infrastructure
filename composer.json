{
    "name": "ak279642/laravel-infrastructure",
    "description": "Production-ready Laravel infrastructure for repositories, safe caching, validation, actions/services, API responses, structured logging, slugs, files, and transactions.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "api",
        "cache",
        "caching",
        "correlation-id",
        "eloquent",
        "file-storage",
        "form-request",
        "image-processing",
        "infrastructure",
        "laravel",
        "logging",
        "octane",
        "query-filter",
        "repository",
        "repository-pattern",
        "service-layer",
        "slug",
        "transactions",
        "validation",
        "webp"
    ],
    "authors": [
        {
            "name": "Avinash Kumar",
            "email": "ak279642@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "Ak279642\\LaravelInfrastructure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ak279642\\LaravelInfrastructure\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ak279642\\LaravelInfrastructure\\LaravelInfrastructureServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:architecture": "phpunit --testsuite=Architecture",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "homepage": "https://github.com/Ak279642/laravel-infrastructure",
    "support": {
        "issues": "https://github.com/Ak279642/laravel-infrastructure/issues",
        "source": "https://github.com/Ak279642/laravel-infrastructure"
    },
    "suggest": {
        "ext-gd": "Required when image processing uses the gd driver.",
        "ext-imagick": "Required when image processing uses the imagick driver."
    }
}
